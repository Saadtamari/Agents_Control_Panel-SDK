{
  "name": "agent-control-panel",
  "version": "0.2.0",
  "description": "Agent Control Panel SDK — fail-open reporting and remote control",
  "license": "Apache-2.0",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "observability",
    "control-plane",
    "openai",
    "anthropic"
  ],
  "homepage": "https://github.com/Saadtamari/Agents_Control_Panel-SDK#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saadtamari/Agents_Control_Panel-SDK.git"
  },
  "bugs": {
    "url": "https://github.com/Saadtamari/Agents_Control_Panel-SDK/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
